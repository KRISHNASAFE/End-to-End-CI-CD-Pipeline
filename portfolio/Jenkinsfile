pipeline {

    agent any

    environment {

        DOCKER_REGISTRY_CREDS = "DOCKER_REGISTRY_CREDS"

        IMAGE_NAME = "portfolio"

        IMAGE_TAG = "v1"

        // Sonar
        SONAR_HOST_URL = credentials('sonar-host-url')

        // Kubernetes kubeconfig credential ID
        K8S_CREDS = "jenkins-kubeconfig"
    }

    stages {

        /*
        =====================================
        Checkout SCM
        =====================================
        */
        stage('Checkout SCM') {
            when {
                anyOf {
                    branch 'main'
                    //branch 'dev'
                }
            }
            steps {
                checkout scm
            }
        }

        /*
        =====================================
        Build (Static Safe)
        =====================================
        */
        stage('Build Portfolio App') {
            steps {
                dir('portfolio') {

                    echo "Building Portfolio Application"

                    sh 'ls -la'

                    // Optional build command
                    // sh 'npm install && npm run build'
                }
            }
        }

        /*
        =====================================
        SonarQube (SAFE OPTIONAL)
        =====================================
        */
        stage('SonarQube Analysis') {
            when {
                branch 'main'
            }
            steps {
                script {
                    if (env.SONAR_HOST_URL?.trim()) {

                        withCredentials([
                            string(credentialsId: 'SONAR_CREDS', variable: 'SONAR_TOKEN')
                        ]) {

                            def scannerHome = tool 'sonar-scanner'

                            echo "Running SonarQube Analysis"

                            sh """
                                ${scannerHome}/bin/sonar-scanner \
                                -Dsonar.host.url=${SONAR_HOST_URL} \
                                -Dsonar.login=${SONAR_TOKEN} \
                                -Dsonar.projectKey=portfolio-app
                            """
                        }

                    } else {
                        echo "SonarQube not configured - skipping"
                    }
                }
            }
        }

        /*
        =====================================
        Docker Build
        =====================================
        */
        stage('Docker Build') {
            steps {
                dir('portfolio') {

                    withCredentials([
                        usernamePassword(
                            credentialsId: "${DOCKER_REGISTRY_CREDS}",
                            usernameVariable: 'DOCKER_USERNAME',
                            passwordVariable: 'DOCKER_PASSWORD'
                        )
                    ]) {

                        echo "Building Docker Image"

                        sh """
                        docker build -t \$DOCKER_USERNAME/${IMAGE_NAME}:${IMAGE_TAG} .
                        """
                    }
                }
            }
        }

        /*
        =====================================
        Trivy Scan
        =====================================
        */
        stage('Trivy Scan') {
            steps {

                withCredentials([
                    usernamePassword(
                        credentialsId: "${DOCKER_REGISTRY_CREDS}",
                        usernameVariable: 'DOCKER_USERNAME',
                        passwordVariable: 'DOCKER_PASSWORD'
                    )
                ]) {

                    echo "Running Trivy Security Scan"

                    sh """
                    trivy image \$DOCKER_USERNAME/${IMAGE_NAME}:${IMAGE_TAG}
                    """
                }
            }
        }

        /*
        =====================================
        Generating SBOM
        =====================================
        */
        stage('Generate SBOM') {
            when {
                branch 'main'
            }
            steps {

                withCredentials([
                    usernamePassword(
                        credentialsId: "${DOCKER_REGISTRY_CREDS}",
                        usernameVariable: 'DOCKER_USERNAME',
                        passwordVariable: 'DOCKER_PASSWORD'
                    )
                ]) {

                    echo "Generating SBOM"

                    sh """
                    syft \$DOCKER_USERNAME/${IMAGE_NAME}:${IMAGE_TAG} -o table
                    """

                    sh """
                    syft \$DOCKER_USERNAME/${IMAGE_NAME}:${IMAGE_TAG} -o spdx-json > sbom.json
                    """
                }
            }
        }

        /*
        =====================================
        Push docker image 
        =====================================
        */

        stage('Push Docker Image') {

            when {
                branch 'main'
            }

            steps {

                withCredentials([
                    usernamePassword(
                        credentialsId: "${DOCKER_REGISTRY_CREDS}",
                        usernameVariable: 'DOCKER_USERNAME',
                        passwordVariable: 'DOCKER_PASSWORD'
                    )
                ]) {

                    echo "Logging into DockerHub"

                    sh """
                    echo \$DOCKER_PASSWORD | docker login -u \$DOCKER_USERNAME --password-stdin
                    """

                    echo "Pushing Docker Image"

                    sh """
                    docker push \$DOCKER_USERNAME/${IMAGE_NAME}:${IMAGE_TAG}
                    """
                }
            }
        }

    }

        /*
        =====================================
        Deploy to Kubernetes (Helm)
        =====================================
        */
        stage('Deploy to Kubernetes') {
            when {
                branch 'main'
            }
            steps {
                withCredentials([
                    file(credentialsId: 'jenkins-kubeconfig', variable: 'KUBECONFIG_FILE')
                ]) {

                    sh """
                        export KUBECONFIG=$KUBECONFIG_FILE

                        echo "Checking cluster..."
                        kubectl get nodes

                    sh """
                    docker push $DOCKER_USERNAME/${IMAGE_NAME}:${IMAGE_TAG}
                    """
                }
            }
        }
    }

    }

    /*
    =====================================
    Post Actions
    =====================================
    */
    post {
        always {
            echo "Cleaning workspace..."
            cleanWs()
            sh 'docker logout || true'
        }

        success {
            echo "Pipeline SUCCESS: ${FULL_IMAGE}"
        }

        failure {
            echo "Pipeline FAILED"
        }
    }
}
