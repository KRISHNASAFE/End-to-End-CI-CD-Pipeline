pipeline {

    agent any

    environment {

        DOCKER_IMAGE = "krishnasafe/portfolio-app"
        IMAGE_TAG = "${BUILD_NUMBER}"
        FULL_IMAGE = "${DOCKER_IMAGE}:${IMAGE_TAG}"

        // Sonar
        SONAR_HOST_URL = credentials('sonar-host-url')

        // Kubernetes kubeconfig credential ID
        K8S_CREDS = "jenkins-kubeconfig"
    }

    stages {

        /*
        =====================================
        Checkout SCM
        =====================================
        */
        stage('Checkout SCM') {
            when {
                anyOf {
                    branch 'main'
                    branch 'dev'
                }
            }
            steps {
                checkout scm
            }
        }

        /*
        =====================================
        Build (Static Safe)
        =====================================
        */
        stage('Build Portfolio App') {
            steps {
                dir('portfolio') {
                    sh '''
                        echo "Checking project type..."

                        if [ -f package.json ]; then
                            echo "Node project detected"
                            npm install
                            npm run build || true
                        else
                            echo "Static site detected - skipping npm build"
                        fi

                        ls -la
                    '''
                }
            }
        }

        /*
        =====================================
        SonarQube (SAFE OPTIONAL)
        =====================================
        */
        stage('SonarQube Analysis') {
            when {
                branch 'main'
            }
            steps {
                script {
                    if (env.SONAR_HOST_URL?.trim()) {

                        withCredentials([
                            string(credentialsId: 'SONAR_CREDS', variable: 'SONAR_TOKEN')
                        ]) {

                            def scannerHome = tool 'sonar-scanner'

                            echo "Running SonarQube scan..."

                            sh """
                                ${scannerHome}/bin/sonar-scanner \
                                -Dsonar.host.url=${SONAR_HOST_URL} \
                                -Dsonar.login=${SONAR_TOKEN} \
                                -Dsonar.projectKey=portfolio-app
                            """
                        }

                    } else {
                        echo "SonarQube not configured - skipping"
                    }
                }
            }
        }

        /*
        =====================================
        Docker Build
        =====================================
        */
        stage('Docker Build') {
            steps {
                dir('portfolio') {
                    sh """
                        echo "Building Docker Image: ${FULL_IMAGE}"
                        docker build -t ${FULL_IMAGE} .
                    """
                }
            }
        }

        /*
        =====================================
        Trivy Scan
        =====================================
        */
        stage('Trivy Scan') {
            steps {
                sh """
                    echo "Running Trivy Scan"
                    trivy image --exit-code 0 --severity HIGH,CRITICAL ${FULL_IMAGE}
                """
            }
        }

        /*
        =====================================
        Docker Push
        =====================================
        */
        stage('Push Docker Image') {
            when {
                branch 'main'
            }
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'DOCKER_REGISTRY_CREDS',
                        usernameVariable: 'DOCKER_USERNAME',
                        passwordVariable: 'DOCKER_PASSWORD'
                    )
                ]) {

                    sh """
                        echo $DOCKER_PASSWORD | docker login -u $DOCKER_USERNAME --password-stdin

                        docker tag ${FULL_IMAGE} $DOCKER_USERNAME/portfolio-app:${IMAGE_TAG}
                        docker push $DOCKER_USERNAME/portfolio-app:${IMAGE_TAG}
                    """
                }
            }
        }

        /*
        =====================================
        SBOM
        =====================================
        */
        stage('Generate SBOM') {
            steps {
                sh """
                    echo "Generating SBOM"
                    syft ${FULL_IMAGE} -o spdx-json > sbom.json
                """
            }
        }

        /*
        =====================================
        Deploy to Kubernetes (Helm)
        =====================================
        */
        stage('Deploy to Kubernetes') {
            when {
                branch 'main'
            }
            steps {
                withCredentials([
                    file(credentialsId: 'jenkins-kubeconfig', variable: 'KUBECONFIG_FILE')
                ]) {

                    sh """
                        export KUBECONFIG=$KUBECONFIG_FILE

                        echo "Checking cluster..."
                        kubectl get nodes

                        echo "Deploying using Helm..."

                        helm upgrade --install portfolio-app ./portfolio/helm \
                            --namespace portfolio \
                            --create-namespace \
                            --set image.tag=${IMAGE_TAG}
                    """
                }
            }
        }
    }

    /*
    =====================================
    Post Actions
    =====================================
    */
    post {
        always {
            echo "Cleaning workspace..."
            cleanWs()
            sh 'docker logout || true'
        }

        success {
            echo "Pipeline SUCCESS: ${FULL_IMAGE}"
        }

        failure {
            echo "Pipeline FAILED"
        }
    }
}
