pipeline {
    agent any

    environment {
        DOCKER_REGISTRY_CREDS = "DOCKER_REGISTRY_CREDS"
        IMAGE_NAME = "portfolio-app"
        IMAGE_TAG = "v1"
        SONAR_HOST_URL = credentials('sonar-host-url')
        K8S_CREDS = "jenkins-kubeconfig"
    }

    stages {

        stage('Checkout SCM') {
            when {
                anyOf { branch 'main' }
            }
            steps {
                checkout scm
            }
        }

        stage('Build Portfolio App') {
            steps {
                dir('portfolio') {
                    echo "Building Portfolio Application"
                    sh 'ls -la'
                    // Optional build: sh 'npm install && npm run build'
                }
            }
        }

        stage('SonarQube Analysis') {
            when { branch 'main' }
            steps {
                script {
                    if (env.SONAR_HOST_URL?.trim()) {
                        withCredentials([string(credentialsId: 'SONAR_CREDS', variable: 'SONAR_TOKEN')]) {
                            def scannerHome = tool 'sonar-scanner'
                            sh """
                                ${scannerHome}/bin/sonar-scanner \
                                -Dsonar.host.url=${SONAR_HOST_URL} \
                                -Dsonar.login=${SONAR_TOKEN} \
                                -Dsonar.projectKey=portfolio-app
                            """
                        }
                    } else {
                        echo "SonarQube not configured - skipping"
                    }
                }
            }
        }

        stage('Docker Build') {
            steps {
                dir('portfolio') {
                    withCredentials([
                        usernamePassword(
                            credentialsId: "${DOCKER_REGISTRY_CREDS}",
                            usernameVariable: 'DOCKER_USERNAME',
                            passwordVariable: 'DOCKER_PASSWORD'
                        )
                    ]) {
                        script {
                            env.FULL_IMAGE = "${DOCKER_USERNAME}/${IMAGE_NAME}:${IMAGE_TAG}"
                        }
                        sh '''
                            docker build -t "$FULL_IMAGE" .
                        '''
                    }
                }
            }
        }

        stage('Trivy Scan') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: "${DOCKER_REGISTRY_CREDS}",
                        usernameVariable: 'DOCKER_USERNAME',
                        passwordVariable: 'DOCKER_PASSWORD'
                    )
                ]) {
                    sh '''
                        trivy image "$FULL_IMAGE"
                    '''
                }
            }
        }

        stage('Generate SBOM') {
            when { branch 'main' }
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: "${DOCKER_REGISTRY_CREDS}",
                        usernameVariable: 'DOCKER_USERNAME',
                        passwordVariable: 'DOCKER_PASSWORD'
                    )
                ]) {
                    sh '''
                        syft "$FULL_IMAGE" -o table
                        syft "$FULL_IMAGE" -o spdx-json > sbom.json
                    '''
                }
            }
        }

        stage('Push Docker Image') {
            when { branch 'main' }
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: "${DOCKER_REGISTRY_CREDS}",
                        usernameVariable: 'DOCKER_USERNAME',
                        passwordVariable: 'DOCKER_PASSWORD'
                    )
                ]) {
                    sh '''
                        echo "$DOCKER_PASSWORD" | docker login -u "$DOCKER_USERNAME" --password-stdin
                        docker push "$FULL_IMAGE"
                    '''
                }
            }
        }

        stage('Deploy to Kubernetes') {
            when { branch 'main' }
            steps {
                withCredentials([file(credentialsId: "${K8S_CREDS}", variable: 'KUBECONFIG_FILE')]) {
                    sh '''
                        export KUBECONFIG="$KUBECONFIG_FILE"
                        echo "Checking cluster..."
                        kubectl get nodes

                        echo "Deploying via Helm..."
                        # Example: helm upgrade --install portfolio-app ./helm --namespace default
                    '''
                }
            }
        }
    }

    post {
        always {
            echo "Cleaning workspace..."
            cleanWs()
            sh 'docker logout || true'
        }

        success {
            echo "Pipeline SUCCESS: ${FULL_IMAGE}"
        }

        failure {
            echo "Pipeline FAILED"
        }
    }
}
