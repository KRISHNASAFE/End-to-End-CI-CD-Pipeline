pipeline {

agent any

environment {

    DOCKER_REGISTRY_CREDS = "DOCKER_REGISTRY_CREDS"

    IMAGE_NAME = "portfolio-app"

    IMAGE_TAG = "${BUILD_NUMBER}"

    SONAR_HOST_URL = credentials('sonar-host-url')

    K8S_CREDS = "jenkins-kubeconfig"
}

stages {

    /*
    =====================================
    Checkout SCM
    =====================================
    */
    stage('Checkout SCM') {
        when {
            anyOf {
                branch 'dev'
            }
        }

        steps {
            checkout scm
        }
    }

    /*
    =====================================
    Build Portfolio App
    =====================================
    */
    stage('Build Portfolio App') {

        steps {

            dir('portfolio') {

                echo "Building Portfolio Application"

                sh 'ls -la'
            }
        }
    }

    /*
    =====================================
    SonarQube Analysis
    =====================================
    */
    stage('SonarQube Analysis') {

        when {
            branch 'dev'
        }

        steps {

            script {

                if (env.SONAR_HOST_URL?.trim()) {

                    withCredentials([
                        string(credentialsId: 'SONAR_CREDS', variable: 'SONAR_TOKEN')
                    ]) {

                        def scannerHome = tool 'sonar-scanner'

                        echo "Running SonarQube Analysis"

                        sh """
                            ${scannerHome}/bin/sonar-scanner \
                            -Dsonar.host.url=\$SONAR_HOST_URL \
                            -Dsonar.token=\$SONAR_TOKEN \
                            -Dsonar.projectKey=portfolio-app
                        """
                    }

                } else {

                    echo "SonarQube not configured - skipping"
                }
            }
        }
    }

    /*
    =====================================
    Docker Build
    =====================================
    */
    stage('Docker Build') {

        steps {

            dir('portfolio') {

                withCredentials([
                    usernamePassword(
                        credentialsId: "${DOCKER_REGISTRY_CREDS}",
                        usernameVariable: 'DOCKER_USERNAME',
                        passwordVariable: 'DOCKER_PASSWORD'
                    )
                ]) {

                    echo "Building Docker Image"

                    sh """
                        docker build -t \$DOCKER_USERNAME/${IMAGE_NAME}:${IMAGE_TAG} .
                    """
                }
            }
        }
    }

    /*
    =====================================
    Trivy Scan
    =====================================
    */
    stage('Trivy Scan') {

        steps {

            withCredentials([
                usernamePassword(
                    credentialsId: "${DOCKER_REGISTRY_CREDS}",
                    usernameVariable: 'DOCKER_USERNAME',
                    passwordVariable: 'DOCKER_PASSWORD'
                )
            ]) {

                echo "Running Trivy Security Scan"

                sh """
                    trivy image \$DOCKER_USERNAME/${IMAGE_NAME}:${IMAGE_TAG}
                """
            }
        }
    }

    /*
    =====================================
    Generate SBOM
    =====================================
    */
    stage('Generate SBOM') {

        when {
            branch 'dev'
        }

        steps {

            withCredentials([
                usernamePassword(
                    credentialsId: "${DOCKER_REGISTRY_CREDS}",
                    usernameVariable: 'DOCKER_USERNAME',
                    passwordVariable: 'DOCKER_PASSWORD'
                )
            ]) {

                echo "Generating SBOM"

                sh """
                    syft \$DOCKER_USERNAME/${IMAGE_NAME}:${IMAGE_TAG} -o table
                """

                sh """
                    syft \$DOCKER_USERNAME/${IMAGE_NAME}:${IMAGE_TAG} -o spdx-json > sbom.json
                """
            }
        }
    }

    /*
    =====================================
    Push Docker Image
    =====================================
    */
    stage('Push Docker Image') {

        when {
            branch 'dev'
        }

        steps {

            withCredentials([
                usernamePassword(
                    credentialsId: "${DOCKER_REGISTRY_CREDS}",
                    usernameVariable: 'DOCKER_USERNAME',
                    passwordVariable: 'DOCKER_PASSWORD'
                )
            ]) {

                echo "Logging into DockerHub"

                sh """
                    echo \$DOCKER_PASSWORD | docker login -u \$DOCKER_USERNAME --password-stdin
                """

                echo "Pushing Docker Image"

                sh """
                    docker push \$DOCKER_USERNAME/${IMAGE_NAME}:${IMAGE_TAG}
                """
            }
        }
    }

    /*
    =====================================
    Deploy to Kubernetes using Helm
    =====================================
    */
    stage('Deploy to Kubernetes') {

        when {
            branch 'dev'
        }

        steps {

            withCredentials([
                file(credentialsId: 'jenkins-kubeconfig', variable: 'KUBECONFIG_FILE')
            ]) {

                withCredentials([
                    usernamePassword(
                        credentialsId: "${DOCKER_REGISTRY_CREDS}",
                        usernameVariable: 'DOCKER_USERNAME',
                        passwordVariable: 'DOCKER_PASSWORD'
                    )
                ]) {

                    dir('portfolio') {

                        sh """
                            export KUBECONFIG=\$KUBECONFIG_FILE

                            echo "Checking cluster..."
                            kubectl get nodes

                            echo "Creating namespace if not exists..."
                            kubectl create namespace jenkins --dry-run=client -o yaml | kubectl apply -f -

                            echo "Deploying application with Helm..."

                            helm upgrade --install portfolio-app ./helm \
                            --namespace jenkins \
                            --set image.repository=\$DOCKER_USERNAME/${IMAGE_NAME} \
                            --set image.tag=${IMAGE_TAG}

                            echo "Deployment completed"

                            kubectl get pods -n jenkins
                            kubectl get svc -n jenkins
                        """
                    }
                }
            }
        }
    }
}

/*
=====================================
Post Actions
=====================================
*/
post {

    always {

        echo "Cleaning workspace..."

        cleanWs()

        sh 'docker logout || true'
    }

    success {

        echo "Pipeline SUCCESS"
    }

    failure {

        echo "Pipeline FAILED"
    }
}
```

}
