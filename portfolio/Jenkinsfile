pipeline {

    agent any

    environment {

        DOCKER_REGISTRY_CREDS = "DOCKER_REGISTRY_CREDS"

        IMAGE_NAME = "portfolio"

        IMAGE_TAG = "v1"

        SONAR_HOST_URL = credentials('sonar-host-url')

        K8S_CREDS = "jenkins-kubeconfig"
    }

    stages {

        /*
        =====================================
        Checkout Source Code
        =====================================
        */

        stage('Checkout SCM') {

            when {
                anyOf {
                    branch 'main'
                    branch 'dev'
                }
            }

            steps {
                checkout scm
            }
        }

        /*
        =====================================
        Build Portfolio Application (Static Safe)
        =====================================
        */

        stage('Build Portfolio App') {

            when {
                anyOf {
                    branch 'main'
                    branch 'dev'
                }
            }

            steps {

                dir('portfolio') {

                    echo "Detecting application type..."

                    sh '''
                        ls -la

                        if [ -f package.json ]; then
                            echo "Node project detected"
                            npm install
                            npm run build || true
                        else
                            echo "Static site detected - skipping npm build"
                        fi
                    '''
                }
            }
        }

        /*
        =====================================
        SonarQube Analysis (SAFE MODE)
        =====================================
        */

        stage('SonarQube Analysis') {

            when {
                branch 'main'
            }

            steps {

                dir('portfolio') {

                    script {

                        if (env.SONAR_HOST_URL?.trim()) {

                            withCredentials([
                                string(
                                    credentialsId: 'SONAR_CREDS',
                                    variable: 'SONAR_TOKEN'
                                )
                            ]) {

                                def scannerHome = tool 'sonar-scanner'

                                echo "Running SonarQube Analysis"

                                sh """
                                ${scannerHome}/bin/sonar-scanner \
                                -Dsonar.host.url=${SONAR_HOST_URL} \
                                -Dsonar.token=${SONAR_TOKEN} \
                                -Dsonar.projectKey=${JOB_NAME}
                                """
                            }

                        } else {
                            echo "SonarQube not configured - skipping"
                        }
                    }
                }
            }
        }

        /*
        =====================================
        Docker Build
        =====================================
        */

        stage('Docker Build') {

            when {
                anyOf {
                    branch 'main'
                    branch 'dev'
                }
            }

            steps {

                dir('portfolio') {

                    script {

                        def imageFull = "${DOCKER_REGISTRY_CREDS}/${IMAGE_NAME}:${BUILD_NUMBER}"

                        env.IMAGE_FULL = imageFull

                        echo "Building Docker Image: ${imageFull}"

                        sh """
                        docker build -t ${imageFull} .
                        """
                    }
                }
            }
        }

        /*
        =====================================
        Trivy Image Scan
        =====================================
        */

        stage('Trivy Image Scan') {

            when {
                anyOf {
                    branch 'main'
                    branch 'dev'
                }
            }

            steps {

                echo "Running Trivy Scan"

                sh """
                trivy image --exit-code 0 --severity HIGH,CRITICAL ${IMAGE_FULL}
                """
            }
        }

        /*
        =====================================
        Push Docker Image
        =====================================
        */

        stage('Push Docker Image') {

            when {
                branch 'main'
            }

            steps {

                withCredentials([
                    usernamePassword(
                        credentialsId: "${DOCKER_REGISTRY_CREDS}",
                        usernameVariable: 'DOCKER_USERNAME',
                        passwordVariable: 'DOCKER_PASSWORD'
                    )
                ]) {

                    echo "Logging into DockerHub"

                    sh """
                    echo \$DOCKER_PASSWORD | docker login -u \$DOCKER_USERNAME --password-stdin
                    docker push ${IMAGE_FULL}
                    """
                }
            }
        }

        /*
        =====================================
        Generate SBOM
        =====================================
        */

        stage('Generate SBOM') {

            when {
                branch 'main'
            }

            steps {

                echo "Generating SBOM"

                sh """
                syft ${IMAGE_FULL} -o spdx-json > sbom.json
                """
            }
        }

        /*
        =====================================
        Deploy to Kubernetes (Helm)
        =====================================
        */

        stage('Deploy to Kubernetes') {

            when {
                branch 'main'
            }

            steps {

                withCredentials([
                    file(credentialsId: 'jenkins-kubeconfig', variable: 'KUBECONFIG_FILE')
                ]) {

                    sh """
                    export KUBECONFIG=$KUBECONFIG_FILE

                    echo "Validating cluster..."
                    kubectl get nodes

                    echo "Deploying via Helm..."

                    helm upgrade --install portfolio-app ./helm-chart \
                        --namespace portfolio \
                        --create-namespace \
                        --set image.tag=${BUILD_NUMBER}
                    """
                }
            }
        }
    }

    /*
    =====================================
    Post Actions
    =====================================
    */

    post {

        always {

            echo 'Cleaning Workspace'

            cleanWs()

            sh 'docker logout || true'
        }

        success {
            echo 'Pipeline Executed Successfully'
        }

        failure {
            echo 'Pipeline Failed'
        }
    }
}
