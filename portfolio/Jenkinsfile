pipeline {
    agent any

    options {
        timestamps()
        disableConcurrentBuilds()
        buildDiscarder(logRotator(numToKeepStr: '10'))
    }

    parameters {
        booleanParam(name: 'RUN_SECURITY_SCAN', defaultValue: true, description: 'Run Trivy scan')
        booleanParam(name: 'PUSH_IMAGE', defaultValue: true, description: 'Push Docker image to registry')
    }

    environment {
        APP_NAME = "portfolio-app"
        DOCKER_IMAGE = "krishnasafe/portfolio-app"
        IMAGE_TAG = "${BUILD_NUMBER}"
        FULL_IMAGE = "${DOCKER_IMAGE}:${IMAGE_TAG}"
        SONAR_PROJECT = "portfolio-app"

        // Kubernetes kubeconfig (Jenkins Secret File ID)
        K8S_CREDS = "jenkins-kubeconfig"
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Build Application') {
            steps {
                sh '''
                    if [ -f package.json ]; then
                        echo "Node project detected - running npm install & build"
                        npm install
                        npm run build || true
                    else
                        echo "Static site detected - skipping npm build"
                        ls -la
                    fi
                '''
            }
        }

        stage('Unit Test (Optional)') {
            steps {
                sh '''
                    if [ -f package.json ]; then
                        npm test || true
                    else
                        echo "No tests for static site"
                    fi
                '''
            }
        }

        stage('SonarQube Analysis') {
            steps {
                withCredentials([string(credentialsId: 'sonar-token', variable: 'SONAR_TOKEN')]) {
                    sh '''
                        if [ -f package.json ]; then
                            sonar-scanner \
                            -Dsonar.projectKey=${SONAR_PROJECT} \
                            -Dsonar.sources=. \
                            -Dsonar.host.url=$SONAR_HOST_URL \
                            -Dsonar.login=$SONAR_TOKEN
                        else
                            echo "Skipping SonarQube scan for static site"
                        fi
                    '''
                }
            }
        }

        stage('Docker Build') {
            steps {
                sh """
                    docker build -t ${FULL_IMAGE} .
                """
            }
        }

        stage('Security Scan (Trivy)') {
            when {
                expression { return params.RUN_SECURITY_SCAN }
            }
            steps {
                sh """
                    trivy image --exit-code 0 --severity HIGH,CRITICAL ${FULL_IMAGE}
                """
            }
        }

        stage('Push Image') {
            when {
                expression { return params.PUSH_IMAGE }
            }
            steps {
                withCredentials([usernamePassword(
                    credentialsId: 'dockerhub-creds',
                    usernameVariable: 'DOCKER_USER',
                    passwordVariable: 'DOCKER_PASS'
                )]) {
                    sh '''
                        echo $DOCKER_PASS | docker login -u $DOCKER_USER --password-stdin
                        docker push ${FULL_IMAGE}
                    '''
                }
            }
        }

        stage('Generate SBOM') {
            steps {
                sh """
                    syft ${FULL_IMAGE} -o json > sbom.json
                """
            }
        }

        stage('Deploy to Kubernetes (Helm)') {
            steps {
                withCredentials([file(credentialsId: env.K8S_CREDS, variable: 'KUBECONFIG_FILE')]) {
                    sh '''
                        export KUBECONFIG=$KUBECONFIG_FILE

                        echo "Checking cluster connection..."
                        kubectl get nodes

                        echo "Deploying via Helm..."
                        helm upgrade --install portfolio-app ./helm-chart \
                            --namespace portfolio \
                            --create-namespace \
                            --set image.tag=${BUILD_NUMBER}
                    '''
                }
            }
        }
    }

    post {
        always {
            echo "Cleaning workspace..."
            cleanWs()
        }

        success {
            echo "Pipeline SUCCESS: ${FULL_IMAGE}"
        }

        failure {
            echo "Pipeline FAILED"
        }
    }
}
