pipeline {

    agent any

    environment {
        DOCKER_REGISTRY_CREDS = "DOCKER_REGISTRY_CREDS"
        IMAGE_NAME = "DOCKER_USERNAME/portfolio"
        IMAGE_TAG = "v1"

        SONAR_HOST_URL = credentials('sonar-host-url')
    }

    stages {

        stage('Checkout SCM') {
            when {
                branch 'main'
            }
            steps {
                checkout scm
            }
        }

        stage('Build Portfolio App') {
            when {
                branch 'main'
            }
            steps {
                dir('portfolio') {
                    echo "Building Portfolio Application"
                    sh 'ls -la'
                }
            }
        }

        stage('SonarQube Analysis') {
            when {
                branch 'main'
            }
            steps {

                dir('portfolio') {

                    withCredentials([
                        string(
                            credentialsId: 'SONAR_CREDS',
                            variable: 'SONAR_TOKEN'
                        )
                    ]) {

                        script {

                            def scannerHome = tool 'sonar-scanner'

                            sh """
                            ${scannerHome}/bin/sonar-scanner \
                            -Dsonar.host.url=${SONAR_HOST_URL} \
                            -Dsonar.token=${SONAR_TOKEN}
                            """
                        }
                    }
                }
            }
        }

        stage('Docker Build') {
            when {
                branch 'main'
            }
            steps {

                dir('portfolio') {

                    echo "Building Docker Image"

                    sh """
                    docker build -t ${IMAGE_NAME}:${IMAGE_TAG} .
                    """
                }
            }
        }

        stage('Trivy Image Scan') {
            when {
                branch 'main'
            }
            steps {

                echo "Running Trivy Security Scan"

                sh """
                trivy image ${IMAGE_NAME}:${IMAGE_TAG}
                """
            }
        }

        stage('Generate SBOM') {
            when {
                branch 'main'
            }
            steps {

                echo "Generating SBOM"

                sh """
                syft ${IMAGE_NAME}:${IMAGE_TAG} -o table
                """

                sh """
                syft ${IMAGE_NAME}:${IMAGE_TAG} -o spdx-json > sbom.json
                """
            }
        }

        stage('Push Docker Image') {
            when {
                branch 'main'
            }
            steps {

                withCredentials([
                    usernamePassword(
                        credentialsId: "${DOCKER_REGISTRY_CREDS}",
                        usernameVariable: 'DOCKER_USERNAME',
                        passwordVariable: 'DOCKER_PASSWORD'
                    )
                ]) {

                    echo "Logging into DockerHub"

                    sh """
                    echo \$DOCKER_PASSWORD | docker login -u \$DOCKER_USERNAME --password-stdin
                    """

                    echo "Pushing Docker Image"

                    sh """
                    docker push ${IMAGE_NAME}:${IMAGE_TAG}
                    """
                }
            }
        }

    }   // <-- IMPORTANT: closes stages block

    post {

        always {

            echo 'Cleaning Workspace'

            cleanWs()

            sh 'docker logout || true'
        }

        success {
            echo 'Pipeline Executed Successfully'
        }

        failure {
            echo 'Pipeline Failed'
        }
    }

}   // <-- closes pipeline
